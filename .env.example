NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter gateway using NVIDIA models for Ask Supra and purchase-bill vision extraction (server-only)
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3.5-super-vl
OPENROUTER_EXTRACTION_MODEL=nvidia/nemotron-3.5-super-vl

# Server-side secret, only for the import and backup scripts (npm run import:load, npm run db:backup).
# Never prefix with NEXT_PUBLIC_ and never set it on Vercel.
SUPABASE_SERVICE_ROLE_KEY=
